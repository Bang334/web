extends ../../layout/default.pug 
include ../../mixins/select-tree.pug
block main
    .main-create
        h2 Thêm mới bạn nữ
        form(
            id="form-create" 
            action=`/admin/products-category/edit/${infoGirl.id}?_method=PATCH` 
            method="POST"
            enctype="multipart/form-data"
        )                                       
            div 
                label(for="name") Nhap ten:
                input(id="name" name="name" type="text" value=infoGirl.name)
            div 
                label(for="parent") Nhap Cha:
                select(name="parent" id="parent" class="form-pickParent" )
                    option(value="") -- Chọn Danh Mục --
                    + select-tree(relative,1,(infoGirl.parent==""?infoGirl.name:infoGirl.parent ))
            div(upload-image)
                label(for="image") Anh:
                input(id="image" name="image" type="file" value="" class="form-control-file" accept="image/*" upload-image-input)
                img(src=infoGirl.image upload-image-preview class="image-preview")
            div    
                label(for="des") Mo ta:
                textarea(name="des" id="des" cols="10" rows="5") #{infoGirl.des} 
            input(type="radio" id="active" name="status" value="active")
            label(for="active") Hoat dong
            input(type="radio" id="active" name="status" value="unactive")
            label(for="unactive") Khong Hoat Dong
            br
            button(id="button-submit") Lưu
    script(src="/js/products.js")   
        